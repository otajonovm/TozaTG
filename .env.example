NODE_ENV=development

# @BotFather dan olingan bot tokeni
BOT_TOKEN=

# https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Admin akkaunt sessiyasi. To'ldirish: npm run mtproto:login
MTPROTO_SESSION=

# Platforma adminlari (vergul bilan). Masalan: 7736700647
ADMIN_TELEGRAM_IDS=

# Lokal manzil bo'lsa va PostgreSQL o'chiq bo'lsa, bot o'zi ichki bazani 127.0.0.1:5432 da ko'taradi.
# Supabase uchun to'g'ridan-to'g'ri ulanishni (5432) DIRECT_URL ga, poolerni DATABASE_URL ga qo'ying.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&connection_limit=5
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public

REDIS_URL=redis://127.0.0.1:6379
